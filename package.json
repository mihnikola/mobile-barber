{
  "name": "barber-app-ver2",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:once": "jest",
    "build:ios": "eas build --platform ios --auto-submit",
    "build:apk": "eas build -p android --profile development",
    "submit:android": "eas build -p android --auto-submit",
    "push:update": "eas update --branch production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^27.1.0",
    "@react-native-firebase/messaging": "^27.1.0",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "axios": "^1.9.0",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "^1.1312.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.13.3",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.10.1",
    "react-test-renderer": "19.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@parcel/watcher@2.6.0": true,
    "postinstall-postinstall@2.1.0": true,
    "protobufjs@7.6.6": true
