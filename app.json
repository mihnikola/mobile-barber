{
  "expo": {
    "name": "barber-app-ver2",
    "slug": "barber-app-ver2",
    "main": "index.js",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splashScreen.png",
      "backgroundColor": "#000000"
    },
    "scheme": "myapp",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mihailovic93.barberappver2",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mihailovic93.barberappver2",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "6dbd65c3-f5f4-4479-993e-7bb978ebc2ce"
      }
    }
  }
}